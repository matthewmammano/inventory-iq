# Copy to .env locally. Never commit real secrets.

# App
APP_ENV=dev
SECRET_KEY=dev-only-not-for-production-change-me
DATABASE_URL=sqlite:///instance/inventory_iq.db
DEBUG=false
PORT=5000
CONTACT_PHONE=(123) 456-7890

# Scheduler - prod ignores this; use Railway cron/worker commands for tasks instead.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=15
DEV_CLOCK_ENABLED=false

# Email HTTPS API
EMAIL_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_API_KEY=
EMAIL_SENDER_EMAIL=xyz@priorityonetechnologies.com
EMAIL_SENDER_NAME=Inventory IQ
EMAIL_TIMEOUT_SECONDS=4
