# Copy to .env locally. Never commit real secrets.

# App
SECRET_KEY=change-me-generate-a-real-secret
DATABASE_URL=sqlite:///instance/inventory_iq.db
DEBUG=false
PORT=5000
CONTACT_PHONE=(123) 456-7890

# Sessions
SESSION_LIFETIME_DAYS=30

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_POLL_SECONDS=15
DEV_CLOCK_ENABLED=false

# Email (Brevo HTTPS API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alert@priorityonetechnologies.com
BREVO_SENDER_NAME=Inventory IQ
BREVO_TIMEOUT_SECONDS=4
