# Inventory IQ Environment Configuration
# Copy to .env and fill in values. DO NOT commit secrets to version control!

# CORE - REQUIRED ALL ENVIRONMENTS
SECRET_KEY=your-secret-key-here  # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# DATABASE - DEV: sqlite:///instance/inventory_iq.db | PROD: postgresql://user:pass@host/db
DATABASE_URL=postgresql://user:password@localhost:5432/inventory_iq

# ENVIRONMENT - dev (debug mode, SQLite ok) or prod (strict, PostgreSQL required)
FLASK_ENV=dev

# SERVER - DEV: 5000 | PROD: Railway provides PORT env var
PORT=5000

# EMAIL - REQUIRED FOR ALERTS
MAIL_SERVER=smtp.gmail.com           # smtp.gmail.com, mail.your-domain.com, localhost (mailhog)
MAIL_PORT=587                         # 587 (TLS), 465 (SSL), 1025 (mailhog)
MAIL_USERNAME=your-email@gmail.com   # DEV: test account | PROD: service account
MAIL_PASSWORD=your-app-password      # DEV: Gmail App Password | PROD: strong token
MAIL_DEFAULT_SENDER=noreply@localhost # Valid email for alerts

# OPTIONAL
CONTACT_PHONE=(908) 910-5439
